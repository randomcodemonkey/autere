{
  "name": "autere",
  "version": "0.7.0",
  "description": "Real-time web dashboard for monitoring pi agent sessions",
  "type": "module",
  "main": "src/backend/index.ts",
  "bin": {
    "autere": "cli/autere.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd src/frontend && npx vite",
    "dev:backend": "tsx watch src/backend/index.ts",
    "build": "npm run build:frontend && npx tsc -p tsconfig.backend.json",
    "build:frontend": "cd src/frontend && npx vite build",
    "start": "tsx src/backend/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && cd src/frontend && npx tsc --noEmit",
    "preview": "cd src/frontend && npx vite preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:component": "cypress run --component",
    "cy:component:open": "cypress open --component",
    "cy:e2e": "cypress run --e2e",
    "cy:e2e:open": "cypress open --e2e",
    "test:all": "npm run test:component && npm run test:e2e",
    "test:cli": "bash cli/test/run.sh",
    "test:component": "npm run cy:component",
    "test:e2e": "npm run build && npx tsx cypress/e2e/support/run-e2e.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:backend": "npx tsc -p tsconfig.backend.json"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "nodemailer": "^10.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@cypress/react18": "^2.0.1",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@monaco-editor/react": "^4.7.0",
    "@types/cypress": "^1.1.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cypress": "^15.21.1",
    "dompurify": "^3.4.14",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "marked": "^18.0.11",
    "monaco-editor": "^0.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "sass": "^1.69.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0"
  }
}
